                            "name": "Create kids",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "exec": [
                                            "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                                            "",
                                            "pm.collectionVariables.set(\"kidId\", pm.response.json().id);",
                                            "",
                                            "let otherKids = [",
                                            "    {",
                                            "        \"firstName\" : \"firstB\",",
                                            "        \"lastName\" : \"lastB\",",
                                            "        \"age\" : 3,",
                                            "        \"needsSpeechLessons\" : true",
                                            "    },",
                                            "    {",
                                            "        \"lastName\" : \"lastC\",",
                                            "        \"firstName\" : \"firstC\",",
                                            "        \"age\" : 2,",
                                            "        \"needsSpeechLessons\" : true",
                                            "    },",
                                            "    {",
                                            "        \"lastName\" : \"lastD\",",
                                            "        \"firstName\" : \"firstD\",",
                                            "        \"age\" : 4,",
                                            "        \"needsSpeechLessons\" : true",
                                            "    },",
                                            "    {",
                                            "        \"lastName\" : \"lastE\",",
                                            "        \"firstName\" : \"firstE\",",
                                            "        \"age\" : 5,",
                                            "        \"needsSpeechLessons\" : true",
                                            "    }",
                                            "];",
                                            "otherKidsIds = {};",
                                            "for (const k of otherKids) {",
                                            "    const res = await pm.sendRequest({",
                                            "        url: pm.collectionVariables.get(\"testUrl\") + \"/kids\",",
                                            "        method: \"POST\",",
                                            "        header: { \"Content-Type\": \"application/json\" },",
                                            "        body: { mode: \"raw\", raw: JSON.stringify({ ...k }) },",
                                            "    });",
                                            "    otherKidsIds[k.firstName] = res.json().id;",
                                            "}",
                                            "pm.collectionVariables.set(\"seedIds\", JSON.stringify(otherKidsIds));",
                                            ""
                                        ],
                                        "type": "text/javascript",
                                        "packages": {},
                                        "requests": {}
                                    }
                                }
                            ],
