    "item": [
        {
            "name": "Auth",
            "description": "Start here. A login saves its token in the collection variable \"token\", and every other request sends it. Other roles log in at the end of the collection: Roles.",
            "item": [
                {
                    "name": "Login as admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('logged in', () => pm.response.to.have.status(200));",
                                    "// a failed login keeps the token of the previous one",
                                    "if (pm.response.code === 200) {",
                                    "    // every request of the collection sends it (collection Authorization: Bearer {{token}})",
                                    "    pm.collectionVariables.set('token', pm.response.json().token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"{{adminUsername}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{testUrl}}/api/auth/login",
                            "host": ["{{testUrl}}"],
                            "path": ["api", "auth", "login"]
                        },
                        "description": "npm run dev creates the admin \"admin\" with the password \"admin-password\"."
                    },
                    "response": []
                },
                {
                    "name": "Me",
