{
    "name": "nodejs-project",
    "version": "1.0.0",
    "description": "Node JS team project for uni with fun challenge by Ivan",
    "main": "src/index.js",
    "directories": {
        "doc": "docs"
    },
    "type": "module",
    "scripts": {
        "start": "node --env-file-if-exists=.env src/server.js",
        "dev": "node scripts/dev.js | pino-pretty",
        "seed": "node --env-file-if-exists=.env scripts/seed.js",
        "snapshot": "node --env-file-if-exists=.env scripts/snapshot.js",
        "db:clear": "node --env-file-if-exists=.env scripts/clear-db.js",
        "test": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Arzzzen105/nodejs-project.git"
    },
    "author": "Arsen",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Arzzzen105/nodejs-project/issues"
    },
    "homepage": "https://github.com/Arzzzen105/nodejs-project#readme",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "express": "^5.2.1",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^14.0.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "supertest": "^7.3.1",
        "vitest": "^5.0.5"
    },
    "lint-staged": {
        "*.{js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "imports": {
        "#storage/*": "./src/storage/*.js"
    }
}
