{
    "name": "nodejs-project",
    "version": "1.0.0",
    "description": "Node JS team project for uni with fun challenge by Ivan",
    "main": "src/index.js",
    "directories": {
        "doc": "docs"
    },
    "type": "module",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js | pino-pretty",
        "test": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Arzzzen105/nodejs-project.git"
    },
    "author": "Arsen",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Arzzzen105/nodejs-project/issues"
    },
    "homepage": "https://github.com/Arzzzen105/nodejs-project#readme",
    "dependencies": {
        "express": "^5.2.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "vitest": "^5.0.5"
    },
    "lint-staged": {
        "*.{js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "imports": {
        "#storage/*": "./src/storage/*.js"
    }
}
