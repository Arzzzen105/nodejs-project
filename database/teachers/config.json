{
    "table": "teachers",
    "primaryKey": "id",
    "timestamps": true,
    "columns": {
        "firstName": {
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 100
        },
        "lastName": {
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 100
        },
        "subjectIds": {
            "type": "array",
            "default": [],
            "items": {
                "references": {
                    "collection": "subjects",
                    "onDelete": "remove"
                }
            }
        }
    },
    "indexes": []
}
