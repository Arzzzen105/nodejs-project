{
    "table": "teachers",
    "primaryKey": "id",
    "columns": {
        "firstName": {
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 100
        },
        "lastName": {
            "type": "string",
            "required": true,
            "minLength": 1,
            "maxLength": 100
        },
        "role": {
            "type": "string",
            "required": true,
            "enum": ["teacher", "assistant", "manager"]
        },
        "email": {
            "type": "string",
            "nullable": true,
            "default": null,
            "maxLength": 254
        },
        "groupIds": { "type": "array", "default": [] }
    },
    "indexes": ["role", "email"]
}
