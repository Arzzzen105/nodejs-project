{
    "table": "groups",
    "primaryKey": "id",
    "timestamps": true,
    "columns": {
        "name": {
            "type": "string",
            "required": true,
            "unique": true,
            "minLength": 1,
            "maxLength": 100
        },
        "age": {
            "type": "integer",
            "required": true,
            "min": 2,
            "max": 5
        },
        "educatorId": {
            "type": "string",
            "nullable": true,
            "default": null,
            "unique": true,
            "references": {
                "collection": "educators",
                "onDelete": "setNull"
            }
        },
        "assistantId": {
            "type": "string",
            "nullable": true,
            "default": null,
            "unique": true,
            "references": {
                "collection": "assistants",
                "onDelete": "setNull"
            }
        }
    },
    "indexes": ["age"]
}
