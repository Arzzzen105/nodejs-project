# Copy this file to .env and fill in the values: npm start reads .env.
# .env is ignored by git; never commit real secrets.

# Key that signs the access tokens. Required. A long random string, e.g. the
# output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=

# Lifetime of an access token: 30m, 8h, 7d. Optional, default: 8h.
# TOKEN_TTL=8h

# The first admin, created only when the database has no accounts yet;
# not needed once any account exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Port of the HTTP server. Optional, default: 3000.
# PORT=3000
